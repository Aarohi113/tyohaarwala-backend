# Server Configuration
PORT=3000
NODE_ENV=development
HOST=http://localhost:3000

# Shopify App Credentials (From Shopify Partner Dashboard > Apps > Your App)
SHOPIFY_API_KEY=your_shopify_client_id_here
SHOPIFY_API_SECRET=your_shopify_client_secret_here

# Public URL of your deployed app (e.g. https://your-backend.onrender.com)
SHOPIFY_APP_URL=http://localhost:3000

# Shopify API Version
SHOPIFY_API_VERSION=2026-10

# Requested OAuth Scopes (comma-separated)
SHOPIFY_SCOPES=write_app_proxy,write_files,read_files,read_products,read_orders

# 32-byte secret key used to encrypt access tokens on disk (Generate a strong random string)
SESSION_ENCRYPTION_KEY=replace_with_a_secure_32_byte_secret_key_for_production

# Optional direct offline access token (only if pre-authenticated for a single development store)
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_SHOP_DOMAIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

